# SciFy RAG Pipeline Environment Variables
# Copy this file to .env and fill in your actual values

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Weaviate Configuration (for Docker setup)
# These are the default values from docker-compose.yml
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_API_KEY=your-weaviate-api-key-here

# Optional: Hugging Face Token (for downloading models)
# Get your token from: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your-huggingface-token-here

# Optional: Custom model paths (if using local models)
# EMBEDDING_MODEL_PATH=path/to/local/embedding/model
# RERANKER_MODEL_PATH=path/to/local/reranker/model

# Optional: Logging configuration
LOG_LEVEL=INFO
LOG_FILE=rag_pipeline.log

# Optional: Performance settings
MAX_CONCURRENT_REQUESTS=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Optional: Fine-tuning settings
TRAINING_BATCH_SIZE=8
LEARNING_RATE=2e-5
NUM_EPOCHS=3
WARMUP_STEPS=100

# Optional: Evaluation settings
EVALUATION_BATCH_SIZE=16
NUM_TEST_QUESTIONS=10 